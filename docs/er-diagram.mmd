  ORGANIZATIONS ||--o{ PORTFOLIOS : "has"
  ORGANIZATIONS ||--o{ GOALS : "owns"
  ORGANIZATIONS ||--o{ SCENARIOS : "owns"
  ORGANIZATIONS ||--o{ IMPORTS : "initiates"
  ORGANIZATIONS ||--o{ AUDIT_LOGS : "logs"

  USERS ||--o{ USER_ROLES : "assigned"
  ROLES ||--o{ USER_ROLES : "contains"
  USERS ||--o{ GOALS : "creates"
  USERS ||--o{ SCENARIOS : "creates"
  USERS ||--o{ DOCUMENTS : "uploads"

  ACCOUNTS ||--o{ HOLDINGS : "contains"
  INSTRUMENTS ||--o{ HOLDINGS : "is_in"
  ACCOUNTS ||--o{ TRANSACTIONS : "has"
  INSTRUMENTS ||--o{ TRANSACTIONS : "referenced_by"
